---
// src/components/Demostracion.astro
interface Props {
  titulo?: string;
  abierto?: boolean;
}

const { titulo = 'Ver demostración', abierto = false } = Astro.props;
---

<details class="bloque-demostracion" open={abierto}>
  <summary class="cabecera-demostracion">
    <span class="icono-desplegar">▶</span>
    <span>{titulo}</span>
  </summary>

  <div class="contenido-demostracion">
    <slot />
    <div class="fin-demostracion" title="Quod Erat Demonstrandum">∎</div>
  </div>
</details>

<style>
  .bloque-demostracion {
    margin: 1.5rem 0;
    border-left: 3px solid var(--sl-color-accent, #2563eb);
    background-color: var(--sl-color-bg-inline-code, rgba(128, 128, 128, 0.08));
    border-radius: 0 8px 8px 0;
    overflow: hidden;
  }

  .cabecera-demostracion {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    font-weight: 600;
    font-style: italic;
    cursor: pointer;
    user-select: none;
    list-style: none; /* Oculta la flecha por defecto en Chrome/Firefox */
    color: var(--sl-color-text);
    transition: background-color 0.2s ease;
  }

  /* Oculta la flecha por defecto en Safari */
  .cabecera-demostracion::-webkit-details-marker {
    display: none;
  }

  .cabecera-demostracion:hover {
    background-color: rgba(128, 128, 128, 0.12);
  }

  .icono-desplegar {
    font-size: 0.7rem;
    transition: transform 0.2s ease;
    color: var(--sl-color-accent, #2563eb);
  }

  /* Rotar la flecha cuando está abierto */
  .bloque-demostracion[open] .icono-desplegar {
    transform: rotate(90deg);
  }

  .contenido-demostracion {
    padding: 0.5rem 1.5rem 1.25rem 1.5rem;
    border-top: 1px solid var(--sl-color-hairline, rgba(128, 128, 128, 0.2));
  }

  /* Símbolo Q.E.D. (cuadrado final de demostración matemática) al pie a la derecha */
  .fin-demostracion {
    text-align: right;
    font-size: 1.1rem;
    color: var(--sl-color-accent, #2563eb);
    margin-top: 0.5rem;
    user-select: none;
  }
</style>